# Public canonical origin. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional public studio email. If omitted, the footer links to /contact.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only contact delivery. Never expose these values to the browser.
RESEND_API_KEY=re_replace_with_real_key
RESEND_FROM_EMAIL=Minneplenka <website@your-verified-domain.example>
CONTACT_TO_EMAIL=replace-with-studio-inbox@example.com

# Recommended shared rate-limit store for distributed production deployments.
UPSTASH_REDIS_REST_URL=https://replace-with-your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_real_token
